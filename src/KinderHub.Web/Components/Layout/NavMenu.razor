@implements IDisposable
@inject NavigationManager NavigationManager

<div class="brand">
    <a href="" class="brand-link">
        <span class="brand-logo">K</span>
        <span class="brand-text">KinderHub<small>Kindergarten app</small></span>
    </a>
</div>

<nav class="side-nav" aria-label="Main navigation">
    <NavLink class="kh-nav-link" href="" Match="NavLinkMatch.All">
        <Icon Name="home" /><span>Home</span>
    </NavLink>

    @* Only Admin and Teacher see these links *@
    <AuthorizeView Roles="Admin,Teacher">
        <div class="nav-heading">Kindergarten</div>
        <NavLink class="kh-nav-link" href="children">
            <Icon Name="users" /><span>Children</span>
        </NavLink>
        <NavLink class="kh-nav-link" href="attendance">
            <Icon Name="check-square" /><span>Attendance</span>
        </NavLink>
        <NavLink class="kh-nav-link" href="reports">
            <Icon Name="clipboard" /><span>Daily reports</span>
        </NavLink>
    </AuthorizeView>

    @* Only Admin sees this link *@
    <AuthorizeView Roles="Admin">
        <NavLink class="kh-nav-link" href="groups">
            <Icon Name="layers" /><span>Groups</span>
        </NavLink>
    </AuthorizeView>

    @* Only Parent sees this link *@
    <AuthorizeView Roles="Parent">
        <div class="nav-heading">My family</div>
        <NavLink class="kh-nav-link" href="my-children">
            <Icon Name="heart" /><span>My children</span>
        </NavLink>
    </AuthorizeView>

    <AuthorizeView>
        <Authorized>
            <NavLink class="kh-nav-link" href="announcements">
                <Icon Name="bell" /><span>Announcements</span>
            </NavLink>

            <div class="nav-heading">Account</div>
            <NavLink class="kh-nav-link" href="Account/Manage">
                <Icon Name="user" /><span>My profile</span>
            </NavLink>
            <form action="Account/Logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                <button type="submit" class="kh-nav-link kh-nav-button">
                    <Icon Name="log-out" /><span>Logout</span>
                </button>
            </form>
        </Authorized>
        <NotAuthorized>
            <div class="nav-heading">Account</div>
            <NavLink class="kh-nav-link" href="Account/Login">
                <Icon Name="log-in" /><span>Login</span>
            </NavLink>
            <NavLink class="kh-nav-link" href="Account/Register">
                <Icon Name="user-plus" /><span>Register</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose() => NavigationManager.LocationChanged -= OnLocationChanged;
}
