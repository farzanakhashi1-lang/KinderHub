@page "/admin/status"
@using System.Diagnostics
@using System.Runtime.InteropServices
@using Microsoft.Extensions.Diagnostics.HealthChecks
@attribute [Authorize(Roles = "Admin")]
@inject HealthCheckService HealthChecks
@inject IWebHostEnvironment Environment

<PageTitle>System status · KinderHub</PageTitle>

<PageHeader Title="System status" Subtitle="Health, performance and resources of the server">
    <Actions>
        <button type="button" class="btn btn-light" @onclick="LoadAsync" disabled="@isLoading">
            <Icon Name="refresh" Size="18" /> Refresh
        </button>
        <a class="btn btn-outline-primary" href="health" target="_blank">Raw /health JSON</a>
    </Actions>
</PageHeader>

@if (report is null)
{
    <LoadingSpinner Text="Checking the system..." />
}
else
{
    <div class="stat-grid">
        <StatCard Title="Overall health" Value="@report.Status.ToString()" IconName="activity"
                  Color="@(report.Status == HealthStatus.Healthy ? "success" : "danger")"
                  Hint="@($"checked in {report.TotalDuration.TotalMilliseconds:0} ms")" />
        <StatCard Title="Uptime" Value="@FormatUptime(uptime)" IconName="clock" Color="primary" />
        <StatCard Title="Memory used" Value="@($"{workingSetMb:0} MB")" IconName="server" Color="accent" Hint="@($"managed heap {gcHeapMb:0.0} MB")" />
        <StatCard Title="Threads" Value="@threadCount.ToString()" IconName="grid" Color="warning" />
    </div>

    <div class="card-grid">
        <div class="kh-card">
            <h2 class="kh-card-title">Health checks</h2>
            @foreach (var entry in report.Entries)
            {
                <div class="status-row" @key="entry.Key">
                    <Badge Text="@entry.Value.Status.ToString()" Color="@(entry.Value.Status == HealthStatus.Healthy ? "success" : "danger")" />
                    <div>
                        <div class="cell-main">@entry.Key</div>
                        <div class="cell-sub">@entry.Value.Description (@entry.Value.Duration.TotalMilliseconds.ToString("0") ms)</div>
                    </div>
                </div>
            }
        </div>
        <div class="kh-card">
            <h2 class="kh-card-title">Server</h2>
            <dl class="info-list">
                <dt>Environment</dt><dd>@Environment.EnvironmentName</dd>
                <dt>.NET</dt><dd>@RuntimeInformation.FrameworkDescription</dd>
                <dt>Operating system</dt><dd>@RuntimeInformation.OSDescription</dd>
                <dt>Processors</dt><dd>@System.Environment.ProcessorCount</dd>
                <dt>Server time</dt><dd>@DateTime.Now.ToString("dd.MM.yyyy HH:mm:ss")</dd>
            </dl>
        </div>
    </div>
}

@code {
    private HealthReport? report;
    private bool isLoading;
    private TimeSpan uptime;
    private double workingSetMb;
    private double gcHeapMb;
    private int threadCount;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        isLoading = true;
        try
        {
            report = await HealthChecks.CheckHealthAsync();

            using var process = Process.GetCurrentProcess();
            uptime = DateTime.Now - process.StartTime;
            workingSetMb = process.WorkingSet64 / 1024d / 1024d;
            threadCount = process.Threads.Count;
            gcHeapMb = GC.GetTotalMemory(forceFullCollection: false) / 1024d / 1024d;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string FormatUptime(TimeSpan t) =>
        t.TotalDays >= 1 ? $"{(int)t.TotalDays}d {t.Hours}h" : t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes}m" : $"{t.Minutes}m {t.Seconds}s";
}
