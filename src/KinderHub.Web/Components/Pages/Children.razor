@page "/children"
@using Microsoft.AspNetCore.Authorization
@using KinderHub.Application.Common
@using KinderHub.Application.DTOs
@using KinderHub.Application.Interfaces
@attribute [Authorize(Roles = "Admin,Teacher")]
@inject IChildService ChildService

<PageTitle>Children</PageTitle>

<h1>Children</h1>
<p class="text-muted">Only Admin and Teacher can open this page.</p>

@if (result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>Total: <strong>@result.TotalCount</strong> children</p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Age</th>
                <th>Group</th>
                <th>Parent</th>
                <th>Phone</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in result.Items)
            {
                <tr @key="c.Id">
                    <td>@c.FullName</td>
                    <td>@c.Age</td>
                    <td>@c.GroupName</td>
                    <td>@c.ParentName</td>
                    <td>@c.ParentPhone</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private PagedResult<ChildDto>? result;

    protected override async Task OnInitializedAsync()
    {
        result = await ChildService.GetPagedAsync(new ChildQuery { PageSize = 50 });
    }
}
